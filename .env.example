# ============================================================
# Ignite Pay — Environment Variables
# Copy to .env and fill in real values before deploying
# ============================================================

# --------------- General ---------------
COMPOSE_PROJECT_NAME=ignite-pay
# devnet | mainnet | local
SOLANA_NETWORK=devnet
RUST_LOG=info

# --------------- Solana RPC ---------------
SOLANA_RPC_URL=https://api.devnet.solana.com
# Photon RPC for ZK Compression (Helius)
PHOTON_RPC_URL=

# --------------- On-chain Program IDs ---------------
CHANNEL_PROGRAM_ID=DJBHr35jL3JAGoU7bKMsEFmpeNMrCSK7oYQE4HJ3GBUe
DID_PROGRAM_ID=D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D1D
SESSION_PROGRAM_ID=6EFvVTh7rEBpHH2JGryjKQmBLRtbYtSEerGNfkHqKiei

# --------------- DIDComm Router (user-side, port 8080) ---------------
ROUTER_USER_PORT=8080
ROUTER_USER_DID=did:ignite:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK
JWT_SECRET=change-me-in-production

# --------------- DIDComm Router (merchant-side, port 4000) ---------------
ROUTER_MERCHANT_PORT=4000
ROUTER_MERCHANT_DID=did:ignite:z6MkMerchantRouterDIDPlaceholder
JWT_SECRET_MERCHANT=change-me-in-production

# --------------- DID Registry (port 8081) ---------------
DID_REGISTRY_PORT=8081
DID_REGISTRY_JWT_SECRET=did-registry-secret
# Payer keypair path inside container (mount the file)
DID_REGISTRY_PAYER_KEYPAIR=/app/keys/payer.key
# Platform signing key (32-byte Ed25519, base64 no-pad)
PLATFORM_SIGNING_KEY_PATH=/app/keys/platform-signing.key
PLATFORM_PUBLIC_KEY=

# --------------- Channel User (port 3001) ---------------
CHANNEL_USER_PORT=3001
CHANNEL_USER_KEYPAIR=/app/keys/user.key

# --------------- Channel Provider (port 3002) ---------------
CHANNEL_PROVIDER_PORT=3002
CHANNEL_PROVIDER_KEYPAIR=/app/keys/provider.key

# --------------- Channel Hub (port 3003) ---------------
CHANNEL_HUB_PORT=3003
CHANNEL_HUB_KEYPAIR=/app/keys/hub.key

# --------------- Hub Registry (port 3004) ---------------
HUB_REGISTRY_PORT=3004
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hub_registry
POSTGRES_USER=ignite
POSTGRES_PASSWORD=ignite

# --------------- User MCP ---------------
USER_MCP_PHONE_DID=
USER_MCP_AUTO_APPROVE_MAX=0
USER_MCP_AUTH_TIMEOUT=300
USER_MCP_PLATFORM_DID=did:ignite:zPlatformDIDPlaceholder

# --------------- Merchant MCP ---------------
MERCHANT_MCP_HUB_ENDPOINT=http://channel-hub:3003
MERCHANT_MCP_HUB_WS_URL=ws://channel-hub:3003/ws
MERCHANT_MCP_PROVIDER_PUBKEY=

# --------------- Firebase (optional) ---------------
# FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FCM_PROJECT_ID=ignite-pay-d1217

# --------------- TLS ---------------
# Place tls.crt and tls.key in deploy/certs/
